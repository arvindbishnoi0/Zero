<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VibeCutPro" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF0B0D12</item>
        <item name="android:windowBackground">#FF0B0D12</item>
    </style>

    <style name="Theme.VibeCutPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0B0D12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VibeCutPro</item>
    </style>
</resources>
