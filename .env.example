# VibeCut Pro — Optional Environment Configuration
# Note: VibeCut Pro is a 100% local-first Android video editing studio.
# No backend server, authentication, or cloud account is required.

# Optional: Path to local Android SDK when building from CLI (Android Studio generates local.properties automatically)
# ANDROID_HOME=/Users/yourname/Library/Android/sdk

# Optional: External Generative AI Inpainting REST Endpoint (configurable inside App Settings -> AI Integration)
VIBECUT_OPTIONAL_AI_ENDPOINT=
VIBECUT_OPTIONAL_AI_API_KEY=

# Optional: Release APK Signing Keystore (only needed for Play Store release builds)
VIBECUT_KEYSTORE_PATH=
VIBECUT_KEYSTORE_PASSWORD=
VIBECUT_KEY_ALIAS=
VIBECUT_KEY_PASSWORD=
